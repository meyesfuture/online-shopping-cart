spring.application.name=online-shopping-cart
server.port=8080
spring.datasource.url=${DB_URL:jdbc:mysql://localhost:3306/online_shop?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC}
spring.datasource.username=${DB_USERNAME:root}
spring.datasource.password=${DB_PASSWORD:}
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver
spring.sql.init.mode=never
app.discount-percent=${DISCOUNT_PERCENT:10}
